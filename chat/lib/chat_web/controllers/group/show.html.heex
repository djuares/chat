<h2><%= @group.name %></h2>

<hr/>

<h3>Mensajes</h3>

<div id="messages">
  <%= for msg <- @messages do %>
    <p>
      <strong><%= msg.sender_user.username %>:</strong>
      <%= msg.content %>
      <small>
        (<%= msg.inserted_at %>)
      </small>
    </p>
  <% end %>
</div>

<hr/>

<h3>Enviar mensaje</h3>

<.form for={%{}} action={~p"/groups/#{@group.id}/messages"} method="post">
  <textarea name="message[content]" required></textarea>
  <br/>
  <button type="submit">Enviar</button>
</.form>
