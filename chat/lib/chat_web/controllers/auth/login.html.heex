<!-- Contenedor principal: ocupa toda la pantalla y centra su contenido -->
<div class="h-screen flex items-center justify-center bg-base-100">
  
  <!-- Caja del login -->
  <div class="w-full max-w-md bg-base-100 shadow-md rounded-lg p-6 mx-4">
    
    <!-- Título -->
    <h1 class="text-2xl font-bold mb-4 text-base-content text-center">
      Iniciar sesión
    </h1>

    <!-- Flash de error -->
    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div class="bg-red-100 text-red-800 px-4 py-2 rounded mb-4">
        <%= Phoenix.Flash.get(@flash, :error) %>
      </div>
    <% end %>

    <!-- Formulario de login -->
    <.form for={%{}} as={:user} action={~p"/login"} method="post" class="space-y-4">

      <!-- Usuario -->
      <div class="form-control">
        <label for="username" class="label">
          <span class="label-text text-base-content">Usuario</span>
        </label>
        <input
          name="user[username]"
          id="username"
          placeholder="Usuario"
          required
          class="input bg-base-200 text-base-content w-full"
        />
      </div>

      <!-- Contraseña -->
      <div class="form-control">
        <label for="password" class="label">
          <span class="label-text text-base-content">Contraseña</span>
        </label>
        <input
          type="password"
          name="user[password]"
          id="password"
          placeholder="Contraseña"
          required
          class="input bg-base-200 text-base-content w-full"
        />
      </div>

      <!-- Botón -->
      <div class="form-control mt-4">
        <button
          type="submit"
          class="btn w-full bg-primary text-primary-content"
        >
          Entrar
        </button>
      </div>
    </.form>

    <!-- Link a registro -->
    <p class="mt-4 text-sm text-base-content text-center">
      ¿No tenés cuenta? 
      <.link href={~p"/register"} class="text-primary font-semibold hover:underline">
        Crear usuario
      </.link>
    </p>

  </div>
</div>
