<body data-theme="whatsapp">
  <div class="min-h-screen flex items-center justify-center bg-base-100 p-6">
    <div class="w-full max-w-md p-6 rounded-lg shadow-md bg-base-100">

      <h1 class="text-2xl font-bold mb-4 text-base-content">Crear usuario</h1>

      <%= if @conn.assigns[:flash][:error] do %>
        <div class="bg-error text-error-content p-2 mb-4 rounded">
          <%= @conn.assigns.flash[:error] %>
        </div>
      <% end %>

      <.form for={%{}} action={~p"/register"} method="post" class="space-y-4">
        <div>
          <label class="block mb-1 text-base-content">Usuario</label>
          <input name="user[username]" required class="input w-full bg-base-200 text-base-content" />
        </div>

        <div>
          <label class="block mb-1 text-base-content">Contraseña</label>
          <input type="password" name="user[password]" required class="input w-full bg-base-200 text-base-content" />
        </div>

        <div>
          <label class="block mb-1 text-base-content">Nombre</label>
          <input name="user[name]" required class="input w-full bg-base-200 text-base-content" />
        </div>

        <div>
          <label class="block mb-1 text-base-content">Email</label>
          <input type="email" name="user[email]" required class="input w-full bg-base-200 text-base-content" />
        </div>

        <div>
          <button type="submit" class="btn w-full bg-primary text-primary-content">
            Crear usuario
          </button>
        </div>
      </.form>
    </div>
  </div>
</body>
