<div class="min-h-screen flex flex-col items-center justify-center bg-blue-500 text-white p-6 text-center">
  <h1 class="text-3xl font-bold mb-6">Crear usuario</h1>

  <%= if @conn.assigns[:flash][:error] do %>
    <div class="bg-red-600 text-white p-2 mb-4 rounded">
      <%= @conn.assigns.flash[:error] %>
    </div>
  <% end %>

  <.form for={%{}} action={~p"/register"} method="post" class="space-y-4 w-full max-w-sm">
    <div>
      <label class="block mb-1">Usuario</label>
      <input name="user[username]" required class="w-full rounded border px-3 py-2"/>
    </div>

    <div>
      <label class="block mb-1">Contraseña</label>
      <input type="password" name="user[password]" required class="w-full rounded border px-3 py-2"/>
    </div>

    <div>
      <label class="block mb-1">Nombre</label>
      <input name="user[name]" required class="w-full rounded border px-3 py-2"/>
    </div>

    <div>
      <label class="block mb-1">Email</label>
      <input type="email" name="user[email]" required class="w-full rounded border px-3 py-2"/>
    </div>

    <div>
      <button type="submit" class="w-full bg-white text-blue-500 font-semibold py-2 px-4 rounded hover:bg-gray-100 transition">
        Crear usuario
      </button>
    </div>
  </.form>
</div>
