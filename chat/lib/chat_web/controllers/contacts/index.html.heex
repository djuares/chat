<.link navigate={~p"/home"} class="btn btn-ghost mb-4">
  ⬅ Volver a home
</.link>

<div class="flex flex-col p-6 space-y-6 w-full">
  <div class="flex flex-col space-y-4">
    <h1 class="text-primary text-2xl font-bold">Contactos 👥</h1>

    <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <.form :let={f} for={%{}} action={~p"/home/contacts"} method="post" class="flex gap-2">
            <input 
            type="text" 
            name="contact_username" 
            placeholder="Nombre de usuario a agregar" 
            required
            class="input input-bordered w-full bg-white" 
            />
            <button type="submit" class="btn btn-primary">
            Agregar
            </button>
        </.form>
    </div>

    <%= if @contacts == [] do %>
        <div class="text-gray-500 text-center py-4 bg-gray-50 rounded-lg border border-dashed border-gray-300">
        <p>No tienes contactos agregados aún.</p>
        </div>
    <% else %>
    
        <ul class="flex flex-col space-y-3 w-full">
    <%= for contact <- @contacts do %>
          <li class="flex items-center justify-between p-4 bg-white border border-gray-100 rounded-xl shadow-sm hover:shadow-md transition-all duration-200">
            
            <div class="flex items-center gap-4">
              <div class="relative">
                <div class="bg-blue-100 p-3 rounded-full text-blue-600">
                
                </div>
                
                <%= if Map.get(contact, :status) == :online do %>
                  <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-500 border-2 border-white rounded-full shadow-sm" title="Online"></span>
                <% else %>
                  <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-gray-400 border-2 border-white rounded-full shadow-sm" title="Offline"></span>
                <% end %>
              </div>

              <div class="flex flex-col">
                <span class="font-bold text-gray-800 text-lg"><%= contact.username %></span>
                <span class="text-xs text-gray-500 font-medium">
                  <%= if Map.get(contact, :status) == :online, do: "En línea", else: "Desconectado" %>
                </span>
              </div>
            </div>

        <.link 
            href={~p"/home/contacts/#{contact.username}/delete"} 
            method="post" 
            data-confirm="¿Estás seguro de eliminar a este contacto?"
            class="text-red-500 hover:text-red-700 hover:bg-red-50 p-2 rounded-full transition-colors"
            title="Eliminar contacto"
        >
            <.icon name="hero-trash" class="w-5 h-5" />
        </.link>
        </li>
    <% end %>
    </ul>
        
    <% end %>
</div>
</div>